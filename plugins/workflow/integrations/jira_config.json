{
  "jira": {
    "enabled": false,
    "base_url": "",
    "project_key": "",
    "api_version": "3",
    "issue_types": {
      "epic": "Epic",
      "story": "Story",
      "task": "Task",
      "subtask": "Sub-task"
    },
    "status_mapping": {
      "pending": "To Do",
      "in_progress": "In Progress",
      "done": "Done",
      "blocked": "Blocked"
    },
    "auto_sync": {
      "enabled": true,
      "on_task_start": true,
      "on_task_done": true,
      "on_blocker": true
    },
    "fields": {
      "use_parent_field": true,
      "description_format": "adf"
    }
  },
  "worktree_integration": {
    "auto_create_on_dev_tasks": false,
    "sync_on_worktree_change": true,
    "comment_on_status_change": true
  }
}
