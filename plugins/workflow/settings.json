{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json, sys; data=json.load(sys.stdin); path=data.get('tool_input',{}).get('file_path',''); sys.exit(2 if any(p in path for p in ['.env', 'credentials', 'secret', '.pem', '.key']) else 0)\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/pre_compact.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/session_start.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/session_end.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/track_changes.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/code_quality_validator.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/jira_auto_sync.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/worktree_auto_update.py\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/notification_handler.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/subagent_tracker.py\" start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DIR}/hooks/subagent_tracker.py\" stop"
          }
        ]
      }
    ]
  }
}
