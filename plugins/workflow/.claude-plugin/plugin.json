{
  "name": "workflow",
  "version": "2.3.1",
  "description": "개발 워크플로우 자동화 - Plan, Design, Build, JIRA 연동, QA 테스트 통합",
  "author": {
    "name": "wondermove lab",
    "email": "support@wondermove.net"
  },
  "homepage": "https://github.com/Wondermove-Inc/calab-claude-plugin",
  "license": "MIT",
  "keywords": [
    "workflow",
    "development",
    "planning",
    "automation",
    "jira",
    "testing",
    "qa"
  ],
  "skills": [
    "./skills/best-practices",
    "./skills/check-quality",
    "./skills/code-quality",
    "./skills/context-refresh",
    "./skills/context-show",
    "./skills/help",
    "./skills/jira-init",
    "./skills/jira-integration",
    "./skills/jira-link",
    "./skills/jira-pull",
    "./skills/jira-push",
    "./skills/jira-status",
    "./skills/jira-sync",
    "./skills/process",
    "./skills/process-build",
    "./skills/process-design",
    "./skills/process-plan",
    "./skills/process-status",
    "./skills/process-tasks",
    "./skills/project-rules",
    "./skills/qa",
    "./skills/qa-plan",
    "./skills/qa-report",
    "./skills/qa-run",
    "./skills/qa-status",
    "./skills/qa-testing",
    "./skills/restore-context",
    "./skills/save-progress",
    "./skills/security-review",
    "./skills/show-rules",
    "./skills/tdd-workflow",
    "./skills/work-tracker",
    "./skills/worktree"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/detect_package_manager.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session_end.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/continuous_learning.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre_compact.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/track_changes.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/auto_format.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/notification_handler.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent_tracker.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/suggest_compact.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sensitive_file_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
