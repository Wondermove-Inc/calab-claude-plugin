{
  "description": "Flash Plugin - Minimal Hooks (token-efficient)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/sensitive_file_guard.py\" ] && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sensitive_file_guard.py\" || true'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact_save_state.py\" ] && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact_save_state.py\" || true'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start_restore_hint.py\" ] && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start_restore_hint.py\" || true'"
          }
        ]
      }
    ]
  }
}
