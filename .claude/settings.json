{
  "env": {
    "MAX_THINKING_TOKENS": "31999"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/sensitive_file_guard.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/suggest_compact.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/precompact_save_state.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/pre_compact.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_start_restore_hint.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_start.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/detect_package_manager.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_end.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/continuous_learning.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/track_changes.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/code_quality_validator.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/auto_format.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/jira_auto_sync.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/worktree_auto_update.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/decision_context.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/user_prompt_submit.py\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notification_handler.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_stop.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/continuous_learning.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/subagent_tracker.py\" start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/subagent_tracker.py\" stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"$HOME/.claude/scripts/statusline_command.py\""
  },
  "plansDirectory": ".claude/plans"
}
